{
  "name": "@chess3d/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chess3d/chess-core": "workspace:*",
    "@chess3d/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.6.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "prisma": "^6.16.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "socket.io-client": "^4.8.1",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
